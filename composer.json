{
    "name": "giovanniramos/pdo4you",
    "type": "library",
    "description": "Modern lightweight database wrapper using PDO",
    "keywords": ["database", "pdo", "mysql", "postgresql", "sqlite"],
    "license": "MIT",
    "authors": [
        {
            "name": "Giovanni Ramos",
            "email": "giovanniramos@msn.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "PDO4You\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PDO4You\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpunit/phpunit": true
        }
    }
}
