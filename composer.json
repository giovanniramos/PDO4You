{
    "name": "giovanniramos/pdo4you",
    "type": "library",
    "description": "Modern lightweight database wrapper using PDO",
    "keywords": ["database", "pdo", "mysql", "postgresql", "sqlite"],
    "license": "MIT",
    "authors": [
        {
            "name": "Giovanni Ramos",
            "email": "giovanniramos@msn.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "PDO4You\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PDO4You\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpunit/phpunit": true
        }
    },
    "scripts": {
        "docker-build": "docker compose build -q --no-cache",
        "docker-test": "docker compose run --rm test",
        "test": [
            "@php -r \"echo chr(27).'[2J'.chr(27).'[H';\"",
            "echo Executando os testes no Docker, aguarde...",
            "@docker-build",
            "@docker-test"
        ]
    }
}
